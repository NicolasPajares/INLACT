rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        );
    }

    // Fotos originales de los ensayos: solo usuarios con perfil pueden acceder.
    match /ensayos/{allPaths=**} {
      allow read, write: if hasProfile();
    }

    // Copias creadas exclusivamente para enlaces públicos.
    // Se permite leer un archivo concreto, pero no listar el contenido del directorio.
    // La escritura/eliminación queda reservada a usuarios con perfil.
    match /ensayos_publicos/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if hasProfile();
    }

    // Todo otro archivo queda bloqueado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}