rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        );
    }

    function isAdmin() {
      return hasProfile()
        && firestore.get(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "admin";
    }

    function canManagePublicEssay(token) {
      let publicPath = /databases/(default)/documents/ensayos_publicos/$(token);
      return hasProfile()
        && firestore.exists(publicPath)
        && firestore.get(publicPath).data.registroId is string
        && (
          isAdmin()
          || (
            firestore.exists(
              /databases/(default)/documents/ensayos/$(firestore.get(publicPath).data.registroId)
            )
            && firestore.get(
              /databases/(default)/documents/ensayos/$(firestore.get(publicPath).data.registroId)
            ).data.creadoPorUid == request.auth.uid
          )
        );
    }

    function canDeletePublicEssayCopy(token) {
      let publicPath = /databases/(default)/documents/ensayos_publicos/$(token);
      // Permite limpiar archivos huérfanos si la publicación no llegó a crearse.
      return hasProfile()
        && (
          !firestore.exists(publicPath)
          || canManagePublicEssay(token)
        );
    }

    // Fotos originales: todos los usuarios con perfil pueden ver y subir.
    // Solo el administrador puede sobrescribir o borrar archivos existentes.
    match /ensayos/{allPaths=**} {
      allow read: if hasProfile();
      allow create: if hasProfile();
      allow update, delete: if isAdmin();
    }

    // Copias para enlaces públicos. Lectura de archivos individuales habilitada,
    // pero no se permite listar directorios ni borrar copias de otro creador.
    match /ensayos_publicos/{token}/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow create: if hasProfile();
      allow update: if canManagePublicEssay(token);
      allow delete: if canDeletePublicEssayCopy(token);
    }

    // Todo otro archivo queda bloqueado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}