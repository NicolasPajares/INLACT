rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BORRADOR: no desplegar en producción hasta probar todas las pantallas.
    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function isAdmin() {
      return hasProfile() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }
    function ownsEnsayo(id) {
      return hasProfile()
        && exists(/databases/$(database)/documents/ensayos/$(id))
        && get(/databases/$(database)/documents/ensayos/$(id)).data.creadoPorUid == request.auth.uid;
    }
    function ownsCotizacion(id) {
      return hasProfile()
        && exists(/databases/$(database)/documents/cotizaciones/$(id))
        && get(/databases/$(database)/documents/cotizaciones/$(id)).data.creadoPorUid == request.auth.uid;
    }
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /clientes/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }
    match /ensayos/{id} {
      allow read: if hasProfile();
      allow create: if hasProfile() && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if hasProfile() && request.resource.data.creadoPorUid == resource.data.creadoPorUid;
      allow delete: if isAdmin();
    }
    match /cotizaciones/{id} {
      allow read: if hasProfile();
      allow create: if hasProfile() && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if hasProfile() && request.resource.data.creadoPorUid == resource.data.creadoPorUid;
      allow delete: if isAdmin();
    }
    match /ensayos_publicos/{token} {
      allow get: if resource.data.activo == true;
      allow list: if false;
      allow create: if isAdmin() || ownsEnsayo(request.resource.data.registroId);
      allow update: if isAdmin()
        || (resource.data.registroId == request.resource.data.registroId && ownsEnsayo(resource.data.registroId));
      allow delete: if isAdmin();
    }
    match /cotizaciones_publicas/{token} {
      allow get: if resource.data.activo == true;
      allow list: if false;
      allow create: if isAdmin() || ownsCotizacion(request.resource.data.registroId);
      allow update: if isAdmin()
        || (resource.data.registroId == request.resource.data.registroId && ownsCotizacion(resource.data.registroId));
      allow delete: if isAdmin();
    }
    match /productos/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }
    match /ubicaciones/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }
    match /listaprecios/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }
    match /stock/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }
    match /movimientos_stock/{id} {
      allow read, create: if hasProfile();
      allow update, delete: if isAdmin();
    }
    match /egresos/{id} {
      allow read, create: if hasProfile();
      allow update, delete: if isAdmin();
    }
    match /visitas/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}