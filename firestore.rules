rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BORRADOR DE SEGURIDAD. Probar antes de desplegar en producción.
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    function ownsEnsayo(id) {
      return hasProfile()
        && exists(/databases/$(database)/documents/ensayos/$(id))
        && get(/databases/$(database)/documents/ensayos/$(id)).data.keys().hasAny(["creadoPorUid"])
        && get(/databases/$(database)/documents/ensayos/$(id)).data.creadoPorUid == request.auth.uid;
    }

    function ownsCotizacion(id) {
      return hasProfile()
        && exists(/databases/$(database)/documents/cotizaciones/$(id))
        && get(/databases/$(database)/documents/cotizaciones/$(id)).data.keys().hasAny(["creadoPorUid"])
        && get(/databases/$(database)/documents/cotizaciones/$(id)).data.creadoPorUid == request.auth.uid;
    }

    function creatorUnchangedOrLegacy() {
      return (
        !resource.data.keys().hasAny(["creadoPorUid"])
        && !request.resource.data.keys().hasAny(["creadoPorUid"])
      ) || request.resource.data.creadoPorUid == resource.data.creadoPorUid;
    }

    function publicationFieldsProtected() {
      return isAdmin()
        || (resource.data.keys().hasAny(["creadoPorUid"])
          && resource.data.creadoPorUid == request.auth.uid)
        || !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["publicacionToken", "publicacionActiva"]);
    }

    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /clientes/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }

    match /ensayos/{id} {
      allow read: if hasProfile();
      allow create: if hasProfile()
        && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if hasProfile()
        && (
          isAdmin()
          || (creatorUnchangedOrLegacy() && publicationFieldsProtected())
        );
      allow delete: if isAdmin();
    }

    match /cotizaciones/{id} {
      allow read: if hasProfile();
      allow create: if hasProfile()
        && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if hasProfile()
        && (
          isAdmin()
          || (creatorUnchangedOrLegacy() && publicationFieldsProtected())
        );
      allow delete: if isAdmin();
    }

    match /ensayos_publicos/{token} {
      allow get: if resource.data.activo == true;
      allow list: if false;
      allow create: if hasProfile()
        && request.resource.data.registroId is string
        && (isAdmin() || ownsEnsayo(request.resource.data.registroId));
      allow update: if hasProfile()
        && (
          isAdmin()
          || (
            resource.data.registroId == request.resource.data.registroId
            && ownsEnsayo(resource.data.registroId)
          )
        );
      allow delete: if isAdmin();
    }

    match /cotizaciones_publicas/{token} {
      allow get: if resource.data.activo == true;
      allow list: if false;
      allow create: if hasProfile()
        && request.resource.data.registroId is string
        && (isAdmin() || ownsCotizacion(request.resource.data.registroId));
      allow update: if hasProfile()
        && (
          isAdmin()
          || (
            resource.data.registroId == request.resource.data.registroId
            && ownsCotizacion(resource.data.registroId)
          )
        );
      allow delete: if isAdmin();
    }

    match /productos/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }

    match /ubicaciones/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }

    match /listaprecios/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }

    match /stock/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }

    match /movimientos_stock/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }

    match /egresos/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }

    match /visitas/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }

    // Todo lo que no esté autorizado expresamente queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}