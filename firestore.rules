rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BORRADOR DE SEGURIDAD. Probar antes de desplegar en producción.
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    function ownsEnsayo(id) {
      return hasProfile()
        && exists(/databases/$(database)/documents/ensayos/$(id))
        && get(/databases/$(database)/documents/ensayos/$(id)).data.keys().hasAny(["creadoPorUid"])
        && get(/databases/$(database)/documents/ensayos/$(id)).data.creadoPorUid == request.auth.uid;
    }

    function ownsCotizacion(id) {
      return hasProfile()
        && exists(/databases/$(database)/documents/cotizaciones/$(id))
        && get(/databases/$(database)/documents/cotizaciones/$(id)).data.keys().hasAny(["creadoPorUid"])
        && get(/databases/$(database)/documents/cotizaciones/$(id)).data.creadoPorUid == request.auth.uid;
    }

    function creatorUnchangedOrLegacy() {
      return (
        !resource.data.keys().hasAny(["creadoPorUid"])
        && !request.resource.data.keys().hasAny(["creadoPorUid"])
      ) || request.resource.data.creadoPorUid == resource.data.creadoPorUid;
    }

    function publicationFieldsProtected() {
      return isAdmin()
        || (resource.data.keys().hasAny(["creadoPorUid"])
          && resource.data.creadoPorUid == request.auth.uid)
        || !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["publicacionToken", "publicacionActiva"]);
    }

    // Las copias públicas solo pueden contener campos destinados al cliente.
    function publicEssayCopyIsValid() {
      return request.resource.data.keys().hasOnly([
          "registroId", "clienteNombre", "creadoPor", "nombreEnsayo",
          "fecha", "propuesta", "dosis", "elaboracion", "resultados",
          "conclusion", "propuestaComercial", "fotos", "activo", "actualizadoEn"
        ])
        && request.resource.data.keys().hasAll(["registroId", "activo"])
        && request.resource.data.registroId is string
        && request.resource.data.activo is bool;
    }

    function publicQuoteCopyIsValid() {
      return request.resource.data.keys().hasOnly([
          "registroId", "clienteNombre", "creadoPor", "nombreCotizacion",
          "fecha", "propuesta", "dosis", "productos", "observaciones",
          "total", "monedaTotal", "activo", "actualizadoEn"
        ])
        && request.resource.data.keys().hasAll(["registroId", "activo"])
        && request.resource.data.registroId is string
        && request.resource.data.activo is bool;
    }

    // Un enlace solo se sirve si el registro original sigue existiendo,
    // sigue publicado y conserva ese mismo token.
    function publicEssayIsActive(token) {
      return resource.data.activo == true
        && resource.data.registroId is string
        && exists(/databases/$(database)/documents/ensayos/$(resource.data.registroId))
        && get(/databases/$(database)/documents/ensayos/$(resource.data.registroId)).data.publicacionActiva == true
        && get(/databases/$(database)/documents/ensayos/$(resource.data.registroId)).data.publicacionToken == token;
    }

    function publicQuoteIsActive(token) {
      return resource.data.activo == true
        && resource.data.registroId is string
        && exists(/databases/$(database)/documents/cotizaciones/$(resource.data.registroId))
        && get(/databases/$(database)/documents/cotizaciones/$(resource.data.registroId)).data.publicacionActiva == true
        && get(/databases/$(database)/documents/cotizaciones/$(resource.data.registroId)).data.publicacionToken == token;
    }

    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /clientes/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }

    match /ensayos/{id} {
      allow read: if hasProfile();
      allow create: if hasProfile()
        && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if hasProfile()
        && (
          isAdmin()
          || (creatorUnchangedOrLegacy() && publicationFieldsProtected())
        );
      allow delete: if isAdmin();
    }

    match /cotizaciones/{id} {
      allow read: if hasProfile();
      allow create: if hasProfile()
        && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if hasProfile()
        && (
          isAdmin()
          || (creatorUnchangedOrLegacy() && publicationFieldsProtected())
        );
      allow delete: if isAdmin();
    }

    match /ensayos_publicos/{token} {
      allow get: if publicEssayIsActive(token);
      allow list: if false;
      allow create: if hasProfile()
        && publicEssayCopyIsValid()
        && exists(/databases/$(database)/documents/ensayos/$(request.resource.data.registroId))
        && (isAdmin() || ownsEnsayo(request.resource.data.registroId));
      allow update: if hasProfile()
        && publicEssayCopyIsValid()
        && exists(/databases/$(database)/documents/ensayos/$(request.resource.data.registroId))
        && resource.data.registroId == request.resource.data.registroId
        && (isAdmin() || ownsEnsayo(resource.data.registroId));
      allow delete: if isAdmin();
    }

    match /cotizaciones_publicas/{token} {
      allow get: if publicQuoteIsActive(token);
      allow list: if false;
      allow create: if hasProfile()
        && publicQuoteCopyIsValid()
        && exists(/databases/$(database)/documents/cotizaciones/$(request.resource.data.registroId))
        && (isAdmin() || ownsCotizacion(request.resource.data.registroId));
      allow update: if hasProfile()
        && publicQuoteCopyIsValid()
        && exists(/databases/$(database)/documents/cotizaciones/$(request.resource.data.registroId))
        && resource.data.registroId == request.resource.data.registroId
        && (isAdmin() || ownsCotizacion(resource.data.registroId));
      allow delete: if isAdmin();
    }

    match /productos/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }

    match /ubicaciones/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }

    match /listaprecios/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }

    match /stock/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }

    match /movimientos_stock/{id} {
      allow read, create, update: if hasProfile();
      allow delete: if isAdmin();
    }

    match /egresos/{id} {
      allow read: if hasProfile();
      // El UID del creador alimenta el historial individual; no debe poder falsificarse.
      allow create: if hasProfile()
        && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if hasProfile() && creatorUnchangedOrLegacy();
      allow delete: if isAdmin();
    }

    match /visitas/{id} {
      allow read: if hasProfile();
      // El UID del creador alimenta el historial individual; no debe poder falsificarse.
      allow create: if hasProfile()
        && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if hasProfile() && creatorUnchangedOrLegacy();
      allow delete: if isAdmin();
    }

    // Todo lo que no esté autorizado expresamente queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}